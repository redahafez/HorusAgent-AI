# HorusAgent-AI Environment Configuration

# Server Ports & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Simulation Mode (True: runs rich smart agent simulation without paid LLM API keys)
MOCK_LLM_MODE=True

# Optional: Live LLM Provider Keys (uncomment to activate real external models)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...

# Vector Store Settings
VECTOR_DIMENSION=128
SIMILARITY_THRESHOLD=0.65
MAX_RAG_CITATIONS=4

# Telemetry & Governance
ENABLE_PII_SANITATION=True
MAX_TOKEN_BUDGET=16000
RATE_LIMIT_PER_MINUTE=60
